module(
    name = "rocks-analysis-pipeline",
    version = "0.1.0",
)

PYTHON_VERSION = "3.14"

bazel_dep(name = "rules_python", version = "2.3.4")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# Only needed for the //:with_ghcss flag in BUILD.bazel, commented out alongside it.
# bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "aspect_rules_py", version = "1.12.1")
bazel_dep(name = "protobuf", version = "36.2")
bazel_dep(name = "he6-cres-spec-sims", version = "0.2.0")
git_override(
    module_name = "he6-cres-spec-sims",
    commit = "fa717f166b210d5111071616ed031907e8f39301",  # main, as of 2026-09-22: "lockfile-sync.yaml: add **/*.bzl trigger (#7)"
    remote = "https://github.com/arifogel/he6-cres-spec-sims.git",
)

bazel_dep(name = "katydid", version = "0.1.0")
git_override(
    module_name = "katydid",
    # claude-release-repo, as of 2026-09-28: "Add @katydid_release module extension: exposes
    # //:katydid_release as a real repo" - not yet merged to main. Move back to a main commit
    # once https://github.com/arifogel/katydid/pull/new/claude-release-repo lands.
    commit = "0e9620273bbfd509dc1a02f384a7f187814524d7",
    remote = "https://github.com/arifogel/katydid.git",
)

katydid_release = use_extension("@katydid//tools:katydid_release_repo.bzl", "katydid_release")
use_repo(katydid_release, "katydid_release")

# ghcss is a private repo; commented out so a plain `bazel build`/`bazel test` never needs to
# fetch it (Bzlmod resolves every bazel_dep unconditionally, regardless of select()/target
# reachability, so this can't be made conditional without a real module_extension - see
# https://bazel.build/rules/lib/globals/module).
# bazel_dep(name = "ghcss", version = "0.1.0")
# git_override(
#     module_name = "ghcss",
#     commit = "d53d21cafac02373e6044d9d588dce5a7936f448",  # main, as of 2026-09-22: "port he6-cres-spec-sims (#2)"
#     remote = "https://github.com/arifogel/ghcss.git",
# )

interpreters = use_extension("@aspect_rules_py//py/unstable:extension.bzl", "python_interpreters")
interpreters.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)
use_repo(interpreters, "python_interpreters")

register_toolchains("@python_interpreters//:all")

uv = use_extension("@aspect_rules_py//uv/unstable:extension.bzl", "uv")
uv.declare_hub(
    hub_name = "rocks_analysis_pipeline_pypi",
)
uv.project(
    hub_name = "rocks_analysis_pipeline_pypi",
    lock = "//:uv.lock",
    pyproject = "//:pyproject.toml",
)
use_repo(uv, pypi = "rocks_analysis_pipeline_pypi")

uv_ext = use_extension("//tools/uv:uv_extension.bzl", "uv_ext")
uv_ext.version(version = "0.11.21")
use_repo(uv_ext, "uv_bin")
