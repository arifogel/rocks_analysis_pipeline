# The venv-sharing target for the release build: warming this one target's own venv gives every
# entry point above a single, already-built venv to run against instead of each carrying its own
# mostly-duplicate one. release_venv.py itself is a no-op; only its venv matters.
py_binary(
    name = "release_venv",
    srcs = ["release_venv.py"],
    main = "release_venv.py",
    deps = [
        ":local_ssa_entry_lib",
        ":wulf_ssa_entry_lib",
    ],
)

# Tiny per-entry-point wrapper scripts around //tools:run_via_warmed_runfiles.sh, meant to sit
# alongside release_venv_warmed/ and run_via_warmed_runfiles.sh itself in the assembled release
# tarball: each just activates release_venv_warmed/'s shared venv and execs its own script.
genrule(
    name = "local_ssa_release_wrapper",
    outs = ["local_ssa.sh"],
    cmd = """cat > $@ << 'WRAPPER_EOF'
#!/usr/bin/env bash
set -euo pipefail
DIR="$$(cd "$$(dirname "$${BASH_SOURCE[0]}")" && pwd)"
RUNFILES_DIR="$$DIR/release_venv_warmed" exec "$$DIR/run_via_warmed_runfiles.sh" release_venv local_ssa "$$@"
WRAPPER_EOF
chmod +x $@
""",
)

genrule(
    name = "wulf_ssa_release_wrapper",
    outs = ["wulf_ssa.sh"],
    cmd = """cat > $@ << 'WRAPPER_EOF'
#!/usr/bin/env bash
set -euo pipefail
DIR="$$(cd "$$(dirname "$${BASH_SOURCE[0]}")" && pwd)"
RUNFILES_DIR="$$DIR/release_venv_warmed" exec "$$DIR/run_via_warmed_runfiles.sh" release_venv wulf_ssa "$$@"
WRAPPER_EOF
chmod +x $@
""",
)

# The single release deliverable, and the only large output in this package - see
# //tools:release_tarball.bzl. Extracts and runs on a bare AlmaLinux host with no Bazel present.
release_tarball(
    name = "release",
    binary = ":release_venv",
    extra_files = [
        ":local_ssa_release_wrapper",
        ":wulf_ssa_release_wrapper",
        "//tools:run_via_warmed_runfiles.sh",
    ],
)

python_ide_backport()
