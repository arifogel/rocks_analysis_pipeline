# Explicit __init__.py for this package and its api/ subpackage. rules_python's implicit
# creation is deprecated (https://github.com/bazel-contrib/rules_python/issues/2945) and
# disabled repo-wide via rules_python_config.explicit_init_py in MODULE.bazel, so every target
# below depends on this directly or transitively instead of relying on it.
py_library(
    name = "package_init_lib",
    srcs = [
        "__init__.py",
        "api/__init__.py",
    ],
    visibility = ["//rocks_analysis_pipeline/api/v1:__pkg__"],
)

